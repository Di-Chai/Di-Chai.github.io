<% trophy = '<svg class="badge-icon" aria-hidden="true" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M17 5h3v1.5a3.5 3.5 0 0 1-3.5 3.5M7 5H4v1.5A3.5 3.5 0 0 0 7.5 10"/></svg>' -%>
<article class="paper" id="paper-<%= h(paper['id']) %>">
  <h4><% if paper['paper'] %><a href="<%= h(paper['paper']) %>"><%= h(paper['title']) %></a><% else %><%= h(paper['title']) %><% end %></h4>
  <p class="paper-authors"><%= paper['authors'].map { |author| author == profile['name'] ? "<strong>#{h(author)}</strong>" : h(author) }.join(', ') %></p>
  <div class="paper-meta">
    <span class="paper-venue"><%= h(paper['venue']) %></span>
    <%= classification_badge(paper) %>
    <% if paper['award'] -%>
    <% if paper['award_image'] -%>
    <a class="badge badge-award award-image-link" href="<%= h(local_asset(paper['award_image'])) %>" data-image-alt="<%= h(paper['award']) %> certificate for <%= h(paper['title']) %>"><%= trophy %><%= h(paper['award']) %></a>
    <% else -%>
    <span class="badge badge-award"><%= trophy %><%= h(paper['award']) %></span>
    <% end -%>
    <% end -%>
    <% if paper['paper'] -%><a class="pill" href="<%= h(paper['paper']) %>" aria-label="Paper: <%= h(paper['title']) %>">Paper</a><% end -%>
    <% if paper['code'] -%><a class="pill" href="<%= h(paper['code']) %>" aria-label="Code: <%= h(paper['title']) %>">Code</a><% end -%>
    <% if paper['video'] -%><a class="pill" href="<%= h(paper['video']) %>" aria-label="Tutorial video: <%= h(paper['title']) %>">Tutorial video</a><% end -%>
  </div>
</article>
