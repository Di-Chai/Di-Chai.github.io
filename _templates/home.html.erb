<!doctype html>
<!-- Generated by ruby scripts/build.rb. Edit _data/*.yml and regenerate. -->
<html lang="<%= h(config.fetch('lang', 'en')) %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(config['title']) %> · <%= h(profile['role']) %></title>
  <meta name="description" content="<%= h(config['description']) %>">
  <meta name="theme-color" content="#ffffff">
  <script src="<%= h(versioned_asset('assets/js/theme.js')) %>"></script>
  <link rel="canonical" href="<%= h(absolute_url) %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= h(profile['name']) %> · <%= h(profile['role']) %>">
  <meta property="og:description" content="<%= h(config['description']) %>">
  <meta property="og:url" content="<%= h(absolute_url) %>">
  <meta property="og:image" content="<%= h(absolute_url(profile['portrait'])) %>">
  <meta property="og:image:alt" content="<%= h(profile['name']) %>">
  <meta name="twitter:card" content="summary">
  <link rel="icon" href="<%= h(local_asset('assets/img/favicon.svg')) %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= h(versioned_asset('assets/css/main.css')) %>">
  <script src="<%= h(versioned_asset('assets/js/navigation.js')) %>" defer></script>
  <script src="<%= h(versioned_asset('assets/js/image-viewer.js')) %>" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell">
    <nav class="nav" aria-label="Page sections">
      <div class="nav-links">
      <a href="#about" aria-current="location">About</a>
      <a href="#hiring">Hiring</a>
      <% if papers.any? { |paper| paper['highlight'] } -%>
      <a href="#research">Projects</a>
      <% end -%>
      <a href="#publications">Publications</a>
      </div>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
        <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
      </button>
    </nav>
    <main id="main">
      <section class="profile" id="about" tabindex="-1" aria-label="About <%= h(profile['name']) %>">
        <div class="profile-heading">
          <h1><%= h(profile['name']) %></h1>
          <p class="position"><%= h(profile['role']) %></p>
          <p class="affiliation"><%= h(profile['department']) %><br><a href="<%= h(profile['institution_url']) %>"><%= h(profile['institution']) %></a></p>
        </div>
        <figure class="profile-photo">
          <img src="<%= h(local_asset(profile['portrait'])) %>" alt="<%= h(profile['name']) %>" width="122" height="140" fetchpriority="high">
          <figcaption><%= h(profile['location']) %></figcaption>
        </figure>
        <div class="biography">
          <p><%= profile['biography'] %></p>
          <% unless profile['collaborations'].to_s.empty? -%>
          <p><%= profile['collaborations'] %></p>
          <% end -%>
          <div class="contact-links">
            <a href="mailto:<%= h(profile['email']) %>">Email ↗</a>
            <a href="<%= h(profile['github']) %>">GitHub ↗</a>
            <a href="<%= h(profile['sufe_profile_url']) %>">SUFE ↗</a>
          </div>
        </div>
      </section>
      <div class="recruitment" id="hiring" tabindex="-1" aria-label="Hiring">
        <% unless profile['recruiting'].to_s.empty? -%>
        <p class="recruit" lang="en"><strong>Recruiting students</strong><%= h(profile['recruiting']) %> <a href="mailto:<%= h(profile['email']) %>"><%= h(profile['email']) %></a></p>
        <% end -%>
        <%= render('students') %>
      </div>
      <% highlights = papers.select { |paper| paper['highlight'] } -%>
      <% unless highlights.empty? -%>
      <section class="section research" id="research" tabindex="-1" aria-labelledby="research-title">
        <div class="section-heading"><h2 id="research-title">Highlighted Projects</h2></div>
        <% highlights.each do |paper| -%>
        <%= render('highlight', paper: paper) %>
        <% end -%>
      </section>
      <% end -%>
      <% selected = papers.select { |paper| paper['selected'] } -%>
      <% remaining = papers.reject { |paper| paper['selected'] } -%>
      <section class="section publications" id="publications" tabindex="-1" aria-labelledby="publications-title">
        <div class="section-heading"><h2 id="publications-title">Publications</h2></div>
        <% (selected.empty? ? papers : selected).each do |paper| -%>
        <%= render('publication', paper: paper) %>
        <% end -%>
        <% unless selected.empty? || remaining.empty? -%>
        <details class="all-publications">
          <summary><span class="when-closed">All publications</span><span class="when-open">Show selected publications</span></summary>
          <div class="other-publications">
            <% remaining.each do |paper| -%>
            <%= render('publication', paper: paper) %>
            <% end -%>
          </div>
        </details>
        <% end -%>
      </section>
    </main>
    <footer class="footer" id="contact" tabindex="-1" aria-label="Contact"><span><%= h(profile['name']) %> · <%= h(profile['institution']) %></span><a href="mailto:<%= h(profile['email']) %>"><%= h(profile['email']) %></a></footer>
  </div>
  <dialog class="image-viewer" id="image-viewer" aria-label="Project image preview">
    <div class="image-viewer-panel">
      <button class="image-viewer-close" type="button" aria-label="Close image preview" autofocus>×</button>
      <img class="image-viewer-image" alt="">
      <p class="image-viewer-hint">Click image or background to close · Esc</p>
    </div>
  </dialog>
</body>
</html>
