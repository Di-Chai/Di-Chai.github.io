<section class="section news" id="news" tabindex="-1" aria-labelledby="news-title">
  <div class="section-heading"><h2 id="news-title">News</h2></div>
  <ul class="news-list">
    <% news.first(HomePage::NEWS_VISIBLE).each do |item| -%>
    <%= render('news-item', item: item) %>
    <% end -%>
  </ul>
  <% earlier = news.drop(HomePage::NEWS_VISIBLE) -%>
  <% unless earlier.empty? -%>
  <details class="earlier-news">
    <summary>Earlier news (<%= earlier.size %>)</summary>
    <ul class="news-list">
      <% earlier.each do |item| -%>
      <%= render('news-item', item: item) %>
      <% end -%>
    </ul>
  </details>
  <% end -%>
</section>
